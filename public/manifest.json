{
  "manifest_version": 3,
  "name": "React Chatbox Extension",
  "version": "1.0.0",
  "description": "A Chrome extension with React chatbox and MCP connection",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg",
      "48": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg",
      "128": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg"
    }
  },
  "icons": {
    "16": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg",
    "48": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg",
    "128": "https://opinary.com/wp-content/uploads/2022/09/Website-favicon-2022-v2-01.svg"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}
